<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleExecutable</key><string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIdentifier</key><string>dev.farna.clashflux</string>
  <key>CFBundleName</key><string>Clash-Flux</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>${PROJECT_VERSION}</string>
  <key>CFBundleVersion</key><string>${PROJECT_VERSION}</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>CFBundleURLTypes</key>
  <array><dict>
    <key>CFBundleURLName</key><string>dev.farna.clashflux.profile</string>
    <key>CFBundleTypeRole</key><string>Viewer</string>
    <key>CFBundleURLSchemes</key>
    <array><string>clash-flux</string><string>sing-box</string><string>flclash</string><string>clash</string><string>clashmeta</string></array>
  </dict></array>
</dict>
</plist>
