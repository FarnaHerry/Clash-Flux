<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Clash-Flux" Manufacturer="dev.farna.clashflux" Version="@HUXERUI_WINDOWS_PROJECT_VERSION@"
           UpgradeCode="@HUXERUI_WINDOWS_MSI_UPGRADE_CODE@" Scope="perMachine">
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Clash-Flux is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ClashFluxApplicationIcon" SourceFile="@HUXERUI_WINDOWS_ICON_FILE@" />
    <Property Id="ARPPRODUCTICON" Value="ClashFluxApplicationIcon" />

    <Binary Id="LegacyBundleCleanup" SourceFile="@HUXERUI_WINDOWS_LEGACY_CLEANUP_DLL@" />
    <CustomAction Id="CleanupLegacyBundles" BinaryRef="LegacyBundleCleanup" DllEntry="CleanupLegacyBundles"
                  Execute="commit" Impersonate="no" Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="CleanupLegacyBundles" After="InstallInitialize" Condition="NOT (REMOVE~=&quot;ALL&quot;)" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Clash-Flux" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="APPLICATIONPROGRAMMENU" Name="Clash-Flux" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="ApplicationFiles" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.Application)\**" />
    </ComponentGroup>
    <Component Id="ApplicationShortcut" Directory="APPLICATIONPROGRAMMENU">
      <Shortcut Id="ApplicationStartMenuShortcut" Name="Clash-Flux"
                Target="[INSTALLFOLDER]clash-flux.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ClashFluxApplicationIcon" />
      <RemoveFolder Id="RemoveApplicationProgramMenu" On="uninstall" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.clashflux\Clash-Flux" Name="installed"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>
    <Component Id="ApplicationDesktopShortcut" Directory="DesktopFolder">
      <Shortcut Id="ApplicationDesktopShortcutLink" Name="Clash-Flux"
                Target="[INSTALLFOLDER]clash-flux.exe" WorkingDirectory="INSTALLFOLDER"
                Icon="ClashFluxApplicationIcon" />
      <RegistryValue Root="HKLM" Key="Software\dev.farna.clashflux\Clash-Flux" Name="desktopShortcut"
                     Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Application" Title="Clash-Flux" Level="1">
      <ComponentGroupRef Id="ApplicationFiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="ServiceCleanup" />
    </Feature>
    <Feature Id="DesktopShortcut" Title="Desktop shortcut" Level="2" AllowAbsent="yes">
      <Level Value="1" Condition="CREATE_DESKTOP_SHORTCUT = 1" />
      <ComponentRef Id="ApplicationDesktopShortcut" />
    </Feature>

    <!-- 应用卸载时同步停止并移除独立网络服务（ServiceControl 只发停止/删除
         命令，不要求服务 exe 属于本包）。MajorUpgrade 卸旧装新时
         UPGRADINGPRODUCTCODE 存在，组件被条件跳过——升级不删服务，代理
         存活；只有彻底卸载才清理服务注册，不再遗留开机自启的孤儿服务。 -->
    <Component Id="ServiceCleanup" Directory="INSTALLFOLDER" Condition="NOT UPGRADINGPRODUCTCODE">
      <RegistryValue Root="HKLM" Key="Software\dev.farna.clashflux\Clash-Flux" Name="serviceCleanup"
                     Type="integer" Value="1" KeyPath="yes" />
      <ServiceControl Id="ClashFluxServiceControl" Name="ClashFluxService"
                      Stop="uninstall" Remove="uninstall" Wait="yes" />
    </Component>
  </Package>
</Wix>
