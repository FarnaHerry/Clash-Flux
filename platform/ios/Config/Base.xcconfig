PRODUCT_NAME = ClashFlux
CLASHFLUX_APP_BUNDLE_IDENTIFIER = dev.farna.clashflux
CLASHFLUX_EXTENSION_BUNDLE_IDENTIFIER = $(CLASHFLUX_APP_BUNDLE_IDENTIFIER).packet-tunnel
CLASHFLUX_APP_GROUP_ID = group.dev.farna.clashflux
MARKETING_VERSION = 0.3.14
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
ENABLE_BITCODE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
SWIFT_VERSION = 5.0
CLANG_CXX_LANGUAGE_STANDARD = c++23
// 关闭 ObjC 模块：全部代码使用经典 #import，统一走文本包含，避免模块
// 缓存对 libc++ 头的额外处理。
CLANG_ENABLE_MODULES = NO
// Apple 的 SDK libc++ 默认定义 _LIBCPP_HAS_NO_EXPERIMENTAL_STOP_TOKEN
// （__config 的实验特性开关），task.h 依赖的 std::stop_token 因此不存在；
// stop_token 是纯头文件实现，无 dylib 符号依赖，显式打开实验特性即可。
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) _LIBCPP_ENABLE_EXPERIMENTAL
CLANG_ENABLE_OBJC_ARC = YES
CLANG_CXX_LIBRARY = libc++
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

CLASHFLUX_PROJECT_ROOT = $(PROJECT_DIR)/../..
HUXERUI_PROJECT_ROOT = $(CLASHFLUX_PROJECT_ROOT)
HUXERUI_CORE_BUILD_DIR = $(PROJECT_TEMP_DIR)/huxerui-core/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
HUXERUI_LINK_OPTIONS_FILE = $(HUXERUI_CORE_BUILD_DIR)/huxerui-ios/clash-flux/link.rsp
CLASHFLUX_LIBBOX_XCFRAMEWORK = $(PROJECT_DIR)/Build/Libbox.xcframework

HEADER_SEARCH_PATHS = $(inherited) "$(CLASHFLUX_PROJECT_ROOT)/third_party/huxerui/include"
// Libbox 的 Go runtime 需要 libresolv（res_9_*），UIKit 侧依赖由
// HuxerUI 平台清单（app）/扩展自己的覆盖值提供。
OTHER_LDFLAGS = $(inherited) -lresolv @"$(HUXERUI_LINK_OPTIONS_FILE)"

#include? "Local.xcconfig"
