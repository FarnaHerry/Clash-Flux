PRODUCT_NAME = ClashFlux
CLASHFLUX_APP_BUNDLE_IDENTIFIER = dev.farna.clashflux
CLASHFLUX_EXTENSION_BUNDLE_IDENTIFIER = $(CLASHFLUX_APP_BUNDLE_IDENTIFIER).packet-tunnel
CLASHFLUX_APP_GROUP_ID = group.dev.farna.clashflux
MARKETING_VERSION = 0.3.9
CURRENT_PROJECT_VERSION = 1
IPHONEOS_DEPLOYMENT_TARGET = 15.0
TARGETED_DEVICE_FAMILY = 1,2
CODE_SIGN_STYLE = Automatic
ENABLE_BITCODE = NO
ENABLE_USER_SCRIPT_SANDBOXING = NO
SWIFT_VERSION = 5.0
CLANG_CXX_LANGUAGE_STANDARD = c++23
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CLANG_CXX_LIBRARY = libc++
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

CLASHFLUX_PROJECT_ROOT = $(PROJECT_DIR)/../..
HUXERUI_PROJECT_ROOT = $(CLASHFLUX_PROJECT_ROOT)
HUXERUI_CORE_BUILD_DIR = $(PROJECT_TEMP_DIR)/huxerui-core/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
HUXERUI_LINK_OPTIONS_FILE = $(HUXERUI_CORE_BUILD_DIR)/huxerui-ios/clash-flux/link.rsp
CLASHFLUX_LIBBOX_XCFRAMEWORK = $(PROJECT_DIR)/Build/Libbox.xcframework

HEADER_SEARCH_PATHS = $(inherited) "$(CLASHFLUX_PROJECT_ROOT)/third_party/huxerui/include"
OTHER_LDFLAGS = $(inherited) @"$(HUXERUI_LINK_OPTIONS_FILE)"

#include? "Local.xcconfig"
