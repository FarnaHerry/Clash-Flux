# Keep discovered platform link requirements as private CPS components of CURL.
# System libraries remain system-provided; this does not copy or replace them.
function(clashflux_cps_system_component imported output)
    string(SHA256 id "${imported}")
    get_property(proxy GLOBAL PROPERTY CLASHFLUX_CPS_PROXY_${id})
    if(proxy)
        set(${output} "${proxy}" PARENT_SCOPE)
        return()
    endif()
    string(MAKE_C_IDENTIFIER "system_${imported}" component)
    set(proxy "clashflux_cps_${component}")
    add_library(${proxy} INTERFACE)
    set_target_properties(${proxy} PROPERTIES EXPORT_NAME "${component}")
    set_property(GLOBAL PROPERTY CLASHFLUX_CPS_PROXY_${id} "${proxy}")
    set_property(GLOBAL APPEND PROPERTY CLASHFLUX_CURL_SYSTEM_TARGETS "${proxy}")
    foreach(property INTERFACE_INCLUDE_DIRECTORIES INTERFACE_SYSTEM_INCLUDE_DIRECTORIES
            INTERFACE_COMPILE_DEFINITIONS INTERFACE_COMPILE_OPTIONS INTERFACE_COMPILE_FEATURES
            INTERFACE_LINK_OPTIONS)
        get_target_property(value ${imported} ${property})
        if(value)
            set_property(TARGET ${proxy} PROPERTY ${property} "${value}")
        endif()
    endforeach()
    # This producer builds C and C++, never CUDA. FindThreads' CUDA transport
    # expression therefore reduces to the ordinary pthread compiler flag.
    if(imported STREQUAL "Threads::Threads" AND THREADS_HAVE_PTHREAD_ARG)
        set_property(TARGET ${proxy} PROPERTY INTERFACE_COMPILE_OPTIONS "-pthread")
    endif()
    get_target_property(configurations ${imported} IMPORTED_CONFIGURATIONS)
    if(configurations)
        if(CMAKE_CONFIGURATION_TYPES)
            set(consumer_configs "${CMAKE_CONFIGURATION_TYPES}")
        else()
            set(consumer_configs "${CMAKE_BUILD_TYPE}")
        endif()
        foreach(config IN LISTS consumer_configs)
            string(TOUPPER "${config}" upper)
            get_property(mapped_set TARGET ${imported} PROPERTY MAP_IMPORTED_CONFIG_${upper} SET)
            if(mapped_set)
                get_target_property(candidates ${imported} MAP_IMPORTED_CONFIG_${upper})
                # An explicitly empty mapping selects the unconfigured artifact.
                if(NOT candidates)
                    set(candidates _CLASHFLUX_NOCONFIG)
                endif()
            else()
                set(candidates "${upper};_CLASHFLUX_NOCONFIG;${configurations}")
            endif()
            set(location "")
            foreach(candidate IN LISTS candidates)
                if(candidate STREQUAL "_CLASHFLUX_NOCONFIG" OR candidate STREQUAL "")
                    set(suffix "")
                else()
                    string(TOUPPER "${candidate}" candidate)
                    set(suffix "_${candidate}")
                endif()
                foreach(property IMPORTED_IMPLIB IMPORTED_LOCATION)
                    get_target_property(location ${imported} ${property}${suffix})
                    if(location)
                        break()
                    endif()
                endforeach()
                if(location)
                    break()
                endif()
            endforeach()
            if(NOT location)
                message(FATAL_ERROR "No ${config} link artifact for system dependency ${imported}")
            endif()
            if(CMAKE_CONFIGURATION_TYPES)
                # The CPS importer supports per-config interface link fields,
                # but CMake's exporter rejects their generator expressions.
                # Add these resolved paths to the native config appendix at install.
                set_property(GLOBAL APPEND PROPERTY CLASHFLUX_CPS_SYSTEM_LOCATIONS_${config}
                    "${component}|${location}")
            else()
                target_link_libraries(${proxy} INTERFACE "${location}")
            endif()
            set_property(GLOBAL APPEND PROPERTY CLASHFLUX_CPS_EXTERNAL_FILES "${location}")
        endforeach()
    else()
        foreach(property IMPORTED_IMPLIB IMPORTED_LOCATION)
            get_target_property(location ${imported} ${property})
            if(location)
                target_link_libraries(${proxy} INTERFACE "${location}")
                set_property(GLOBAL APPEND PROPERTY CLASHFLUX_CPS_EXTERNAL_FILES "${location}")
                break()
            endif()
        endforeach()
    endif()
    get_target_property(links ${imported} INTERFACE_LINK_LIBRARIES)
    get_target_property(directories ${imported} INTERFACE_LINK_DIRECTORIES)
    if(links)
        foreach(link IN LISTS links)
            if(TARGET "${link}")
                clashflux_cps_system_component("${link}" dependency)
                target_link_libraries(${proxy} INTERFACE "${dependency}")
            elseif(link MATCHES "^[a-zA-Z0-9_.-]+$")
                string(SHA256 library_id "${imported}|${link}|${directories}")
                find_library(clashflux_system_${library_id} NAMES "${link}" HINTS ${directories})
                if(clashflux_system_${library_id})
                    set(link "${clashflux_system_${library_id}}")
                endif()
                target_link_libraries(${proxy} INTERFACE "${link}")
                if(IS_ABSOLUTE "${link}")
                    set_property(GLOBAL APPEND PROPERTY CLASHFLUX_CPS_EXTERNAL_FILES "${link}")
                endif()
            else()
                # Imported system providers must expose concrete usage requirements.
                # Unsupported expressions are diagnosed by the CPS exporter.
                target_link_libraries(${proxy} INTERFACE "${link}")
            endif()
        endforeach()
    endif()
    set(${output} "${proxy}" PARENT_SCOPE)
endfunction()

function(clashflux_prepare_curl_export)
    get_target_property(target CURL::libcurl ALIASED_TARGET)
    get_target_property(links ${target} INTERFACE_LINK_LIBRARIES)
    if(links)
        string(REGEX MATCHALL "[a-zA-Z0-9_.+-]+::[a-zA-Z0-9_.+-]+" imports "${links}")
        list(REMOVE_DUPLICATES imports)
        foreach(imported IN LISTS imports)
            clashflux_cps_system_component("${imported}" proxy)
            string(REPLACE "${imported}" "${proxy}" links "${links}")
        endforeach()
        set_property(TARGET ${target} PROPERTY INTERFACE_LINK_LIBRARIES "${links}")
    endif()
endfunction()

function(clashflux_cps_json_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(clashflux_install_system_configurations)
    set(mapping "{}")
    foreach(config IN LISTS CMAKE_CONFIGURATION_TYPES)
        get_property(records GLOBAL PROPERTY CLASHFLUX_CPS_SYSTEM_LOCATIONS_${config})
        set(components "{}")
        foreach(record IN LISTS records)
            string(FIND "${record}" "|" split)
            string(SUBSTRING "${record}" 0 ${split} component)
            math(EXPR split "${split} + 1")
            string(SUBSTRING "${record}" ${split} -1 location)
            clashflux_cps_json_quote("${location}" quoted)
            string(JSON components SET "${components}" "${component}" "{\"link_libraries\":[${quoted}]}")
        endforeach()
        string(JSON mapping SET "${mapping}" "${config}" "${components}")
    endforeach()
    set(CLASHFLUX_CPS_SYSTEM_MAPPING "${CMAKE_CURRENT_BINARY_DIR}/cps-system-configurations.json")
    file(WRITE "${CLASHFLUX_CPS_SYSTEM_MAPPING}" "${mapping}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/InstallSystemConfigurations.cmake.in"
        "${CMAKE_CURRENT_BINARY_DIR}/InstallSystemConfigurations.cmake" @ONLY)
    install(SCRIPT "${CMAKE_CURRENT_BINARY_DIR}/InstallSystemConfigurations.cmake"
        COMPONENT ClashFluxDependencies)
endfunction()
