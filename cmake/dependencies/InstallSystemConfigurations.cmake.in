# Complete native CURL CPS config appendices with resolved system link paths.
file(READ "@CLASHFLUX_CPS_SYSTEM_MAPPING@" mapping)
string(JSON components ERROR_VARIABLE error GET "${mapping}" "${CMAKE_INSTALL_CONFIG_NAME}")
if(error)
    return()
endif()
string(JSON count LENGTH "${components}")
if(count EQUAL 0)
    return()
endif()
string(TOLOWER "${CMAKE_INSTALL_CONFIG_NAME}" config)
set(path "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/lib/cps/CURL/CURL@${config}.cps")
file(READ "${path}" package)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON component MEMBER "${components}" ${index})
    string(JSON fields GET "${components}" "${component}")
    string(JSON package SET "${package}" components "${component}" "${fields}")
endforeach()
file(WRITE "${path}" "${package}\n")
